# Copy to .env (gitignored) and fill in what you need. Every setting is optional.

# --- Docker compose (docker compose up) ---
# The address learners use, without a trailing slash. Default: http://localhost:8000
# ILP_PUBLIC_URL=https://learn.example.com
# A content directory outside this repo, mounted at /app/content. Default: ./content
# ILP_CONTENT_HOST_DIR=../my-courses
# Kratos secrets. Random ones are generated on the first run and kept in a Docker volume, so
# you normally leave these alone. Set them only to use your own (the cipher secret must be
# exactly 32 characters, e.g. `openssl rand -hex 16`).
# ILP_KRATOS_COOKIE_SECRET=
# ILP_KRATOS_CIPHER_SECRET=
# HTTPS, off by default (docs/HTTPS.md). Put fullchain.pem and privkey.pem in ./certs (gitignored),
# then set ILP_TLS=true and ILP_HOST_PORT=443. Works behind Cloudflare in Full (strict) mode with an
# Origin CA certificate. Secure cookies follow ILP_TLS.
# ILP_TLS=true
# ILP_HOST_PORT=443
# ILP_TLS_CERT=fullchain.pem
# ILP_TLS_KEY=privkey.pem
# ILP_CERTS_HOST_DIR=./certs
# Secure cookies. Only needed when TLS is ended in front of the app (e.g. Cloudflare Flexible).
# ILP_SECURE_COOKIES=true
# Cloudflare Turnstile on sign-up and sign-in. Off unless BOTH are set; until then sign-up shows a
# placeholder checkbox and sign-in has no check (see docs/ARCHITECTURE.md, Accounts). Turning it on
# loads Cloudflare's script (challenges.cloudflare.com) in the browser.
# ILP_TURNSTILE_SITE_KEY=
# ILP_TURNSTILE_SECRET=
# ILP_MODE=multi
# ILP_DEV=1

# --- Without Docker: uv run --env-file .env uvicorn server.app.main:app ---
# ILP_CONTENT_DIR=../my-courses
